# Copy to dev.env and prod.env in this folder (both gitignored), then change the
# password. tasks.ps1 k8s-up turns each file into a Kubernetes Secret named
# "shopflow-db" in its namespace. Use only letters and digits in the password:
# it is placed inside a database URL.
POSTGRES_USER=shopflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopflow
